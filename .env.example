# Copy to .env and replace every placeholder before starting.
# Generate secrets with: openssl rand -hex 32

# --- Database -----------------------------------------------------------------
# Use long random values; the API no longer accepts published defaults.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-db-root-password
MYSQL_DATABASE=gopress
MYSQL_USER=gopress
MYSQL_PASSWORD=replace-with-a-strong-db-password

# --- Local (non-Docker) development only --------------------------------------
MYSQL_DSN="gopress:replace-with-a-strong-db-password@tcp(127.0.0.1:3306)/gopress?charset=utf8mb4&parseTime=True&loc=Local"
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
PORT=8080

# --- Application --------------------------------------------------------------
# Required. Must be at least 32 characters and must not be a published value;
# a guessed signing key lets anyone forge an admin token.
JWT_SECRET=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Comma-separated CIDRs of reverse proxies allowed to supply X-Forwarded-For.
TRUSTED_PROXIES=
# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false
# Uploaded files live here; in Docker this is the uploads_data volume.
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=64

# --- Update check / CI/CD -----------------------------------------------------
# Repository and branch compared by the admin update page.
GITHUB_REPO=Bigzzh2022/GoPress
GITHUB_BRANCH=main
# Optional. Raises the GitHub API rate limit and allows private repositories.
GITHUB_TOKEN=
# Image tag used by docker compose. latest follows main; pin with sha-xxxxxxx.
GOPRESS_TAG=latest

# --- First administrator ------------------------------------------------------
# Required for the first seed run. At least 12 characters mixing three of:
# lowercase, uppercase, digits, symbols. Published passwords are rejected.
ADMIN_NAME="GoPress Admin"
ADMIN_EMAIL=admin@gopress.dev
ADMIN_PASSWORD=replace-with-a-strong-password
SEED_DEMO=true

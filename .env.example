# Local development defaults. Change all secrets before deploying.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=gopress
MYSQL_USER=gopress
MYSQL_PASSWORD=gopress
MYSQL_DSN="gopress:gopress@tcp(127.0.0.1:3306)/gopress?charset=utf8mb4&parseTime=True&loc=Local"
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
PORT=8080
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
ADMIN_NAME="GoPress Admin"
ADMIN_EMAIL=admin@gopress.dev
ADMIN_PASSWORD=GoPress123!
SEED_DEMO=true
